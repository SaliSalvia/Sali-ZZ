<?xml version="1.0" encoding="utf-8"?>
<!-- Encrypted prefs + Room DB must NEVER be restored onto another device:
     the AndroidKeyStore keys that protect them do not travel with a backup
     or a Mi Mover / device transfer, so a restored sali_zzai_secure.xml is
     undecryptable there and used to crash Application.onCreate on launch. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="datastore/" />
</full-backup-content>
